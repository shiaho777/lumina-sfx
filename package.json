{
  "name": "lumina-sfx-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "qa": "node --experimental-strip-types --disable-warning=ExperimentalWarning qa/run.mjs",
    "test:scenes": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test qa/scene.test.mjs qa/scene-mood.test.mjs qa/intent-search.test.mjs qa/editorial.test.mjs",
    "test:music": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test qa/music.test.mjs qa/music-render.test.mjs qa/production-audio.test.mjs qa/adaptive-music.test.mjs qa/harmony-performance.test.mjs",
    "music": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/music.mjs",
    "scene:install": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/install-scene.mjs",
    "scene:preview": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/preview-scene.mjs",
    "audition": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/audition.mjs",
    "compare": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/compare.mjs",
    "catalog": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-catalog.mjs",
    "search": "node scripts/search.mjs",
    "demo": "vite --config demo/vite.config.ts",
    "build": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "review:summary": "node scripts/review-summary.mjs",
    "levels:audit": "node --experimental-strip-types --disable-warning=ExperimentalWarning qa/level-audit.mjs",
    "bank": "node scripts/export-bank.mjs",
    "bank:3d": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-3d-bank.mjs",
    "remix": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/remix.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}
